{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["chrome", "dom-chromium-ai"]
  },
  "include": ["spikes/src/**/*.ts", "spikes/manifest.config.ts", "spikes/vite.config.ts"]
}
