{
  "name": "promptahead",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config extension/vite.config.ts",
    "typecheck": "tsc -p tsconfig.spikes.json && tsc -p tsconfig.extension.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spikes:build": "vite build --config spikes/vite.config.ts",
    "spikes:dev": "vite build --config spikes/vite.config.ts --watch"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@eslint/js": "^9.19.0",
    "@types/chrome": "^0.0.304",
    "@types/dom-chromium-ai": "^0.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
